diff --git a/target/linux/rockchip/patches-6.12/0100-agibot-rk806-pmic-reset-func.patch b/target/linux/rockchip/patches-6.12/0100-agibot-rk806-pmic-reset-func.patch
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/0100-agibot-rk806-pmic-reset-func.patch
@@ -0,0 +1,27 @@
+--- a/drivers/mfd/rk8xx-core.c
++++ b/drivers/mfd/rk8xx-core.c
+@@ -782,0 +783,24 @@
++	if (rk808->variant == RK806_ID) {
++		u32 rst_fun;
++
++		ret = device_property_read_u32(dev, "pmic-reset-func", &rst_fun);
++		if (!ret) {
++			if (rst_fun > 3)
++				return dev_err_probe(dev, -EINVAL,
++						     "invalid pmic-reset-func %u\n", rst_fun);
++			ret = regmap_update_bits(rk808->regmap, RK806_SYS_CFG3,
++						 0xc0, (rst_fun & 0x3) << 6);
++			if (ret)
++				return dev_err_probe(dev, ret,
++						     "failed to set pmic reset function\n");
++			ret = regmap_read(rk808->regmap, RK806_SYS_CFG3, &rst_fun);
++			if (ret)
++				return dev_err_probe(dev, ret,
++						     "failed to verify pmic reset function\n");
++			if (((rst_fun >> 6) & 0x3) != 1)
++				return dev_err_probe(dev, -EIO,
++						     "pmic reset function readback failed: SYS_CFG3=0x%02x\n",
++						     rst_fun);
++			dev_info(dev, "RK806 reset key enabled: SYS_CFG3=0x%02x\n", rst_fun);
++		}
++	}
++
