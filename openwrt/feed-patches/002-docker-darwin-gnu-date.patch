diff --git a/feeds/packages/utils/docker/patches/010-fix-darwin-gnu-date.patch b/feeds/packages/utils/docker/patches/010-fix-darwin-gnu-date.patch
new file mode 100644
index 000000000..f58a0b6f8
--- /dev/null
+++ b/feeds/packages/utils/docker/patches/010-fix-darwin-gnu-date.patch
@@ -0,0 +1,21 @@
+--- a/scripts/build/.variables
++++ b/scripts/build/.variables
+@@ -12,13 +12,15 @@ VERSION=${VERSION:-$(git describe --matc
+ GITCOMMIT=${GITCOMMIT:-$(git rev-parse --short HEAD 2> /dev/null || true)}
+ 
+ if [ "$(uname)" = "Darwin" ]; then
+-    # Using BSD date (macOS), which doesn't suppoort the --date option
+-    # date -jf "<input format>" "<input value>" +"<output format>" (https://unix.stackexchange.com/a/86510)
+-    BUILDTIME=${BUILDTIME:-$(TZ=UTC date -jf "%s" "${SOURCE_DATE_EPOCH:-$(date +%s)}" +"%Y-%m-%dT%H:%M:%SZ")}
++    # Support both BSD date and Homebrew GNU date on macOS.
++    BUILD_EPOCH="${SOURCE_DATE_EPOCH:-$(date +%s)}"
++    if [ -z "${BUILDTIME:-}" ]; then
++        BUILDTIME="$(TZ=UTC date -u --date="@${BUILD_EPOCH}" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || TZ=UTC /bin/date -u -r "${BUILD_EPOCH}" +"%Y-%m-%dT%H:%M:%SZ")"
++    fi
+ else
+     # Using GNU date (Linux)
+     BUILDTIME=${BUILDTIME:-$(TZ=UTC date -u --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" +"%Y-%m-%dT%H:%M:%SZ")}
+ fi
+ 
+ case "$VERSION" in
+ 	refs/tags/v*) VERSION=${VERSION#refs/tags/v} ;;
