# AGIBOT MB0002 V2 U-Boot overrides.
#
# The common rk3588 defconfig remains the base so Rockchip loader, trust,
# FIT, AVB, storage, and USB policy stay synchronized with RKR6.  Only the
# early bootloader device tree is board-specific here.
CONFIG_BASE_DEFCONFIG="rk3588_defconfig"
CONFIG_DEFAULT_DEVICE_TREE="rk3588-agibot-mb0002-v2"
CONFIG_OF_LIST="rk3588-agibot-mb0002-v2"
CONFIG_BOOTDELAY=3
