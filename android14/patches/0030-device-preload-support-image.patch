From 8f29491804347b42967b78f0fc336b1afcb535d4 Mon Sep 17 00:00:00 2001
From: Cennac <cennac@163.com>
Date: Wed, 26 Aug 2026 16:05:01 +0800
Subject: [PATCH] agibot: preload support image into Gallery storage

---
 agibot_mb0002/agibot_mb0002.mk                |   4 +++-
 .../support/init.agibot-support-media.rc      |   8 ++++++++
 agibot_mb0002/support/support-a-coffee.png    | Bin 0 -> 1404965 bytes
 3 files changed, 11 insertions(+), 1 deletion(-)
 create mode 100644 agibot_mb0002/support/init.agibot-support-media.rc
 create mode 100644 agibot_mb0002/support/support-a-coffee.png

diff --git a/agibot_mb0002/agibot_mb0002.mk b/agibot_mb0002/agibot_mb0002.mk
index 0f99d6a..b37ca02 100644
--- a/agibot_mb0002/agibot_mb0002.mk
+++ b/agibot_mb0002/agibot_mb0002.mk
@@ -66,4 +66,6 @@ PRODUCT_SYSTEM_PROPERTIES += \
     ro.build.author.website=cennac.com
 
 PRODUCT_COPY_FILES += \
-    frameworks/native/data/etc/android.hardware.usb.host.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.usb.host.xml
+    frameworks/native/data/etc/android.hardware.usb.host.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.usb.host.xml \
+    $(LOCAL_PATH)/support/support-a-coffee.png:$(TARGET_COPY_OUT_PRODUCT)/etc/agibot/support-a-coffee.png \
+    $(LOCAL_PATH)/support/init.agibot-support-media.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.agibot-support-media.rc
diff --git a/agibot_mb0002/support/init.agibot-support-media.rc b/agibot_mb0002/support/init.agibot-support-media.rc
new file mode 100644
index 0000000..c6724f5
--- /dev/null
+++ b/agibot_mb0002/support/init.agibot-support-media.rc
@@ -0,0 +1,8 @@
+# Keep the AGIBOT support image visible to Gallery apps through shared storage.
+on property:sys.boot_completed=1
+    mkdir /data/media/0/Pictures 0770 media_rw media_rw
+    mkdir /data/media/0/Pictures/AGIBOT 0770 media_rw media_rw
+    copy /product/etc/agibot/support-a-coffee.png /data/media/0/Pictures/AGIBOT/support-a-coffee.png
+    chown media_rw media_rw /data/media/0/Pictures/AGIBOT/support-a-coffee.png
+    chmod 0660 /data/media/0/Pictures/AGIBOT/support-a-coffee.png
+    restorecon_recursive /data/media/0/Pictures/AGIBOT
diff --git a/agibot_mb0002/support/support-a-coffee.png b/agibot_mb0002/support/support-a-coffee.png
new file mode 100644
index 0000000000000000000000000000000000000000..d165baa11936af14c618e19fe9b526b7e373e9ac
GIT binary patch
