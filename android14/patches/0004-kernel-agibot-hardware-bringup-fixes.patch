From 240668f1c05dabe717a40573aba2a7b2b1bd57d1 Mon Sep 17 00:00:00 2001
From: Cennac <cennac@163.com>
Date: Mon, 24 Aug 2026 22:04:28 +0800
Subject: [PATCH] arm64: dts: fix AGIBOT hardware bring-up

---
 .../dts/rockchip/rk3588-agibot-mb0002-v2.dts | 29 +++++++++++++++++++
 drivers/usb/misc/agibot-hub-reset.c           | 22 +++++++++++---
 2 files changed, 47 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-agibot-mb0002-v2.dts b/arch/arm64/boot/dts/rockchip/rk3588-agibot-mb0002-v2.dts
index 26edb358d792..c6ecaabee6cd 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-agibot-mb0002-v2.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-agibot-mb0002-v2.dts
@@ -66,7 +66,20 @@ agibot_usb_hub_reset: usb-hub-reset {
 		compatible = "agibot,mb0002-usb-hub-reset";
 		reset-gpios = <&gpio4 RK_PD2 GPIO_ACTIVE_LOW>,
 			      <&gpio4 RK_PD3 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&pca9555_20 0 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 1 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 2 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 3 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 4 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 5 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 6 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 7 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 8 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 9 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 10 GPIO_ACTIVE_HIGH>,
+			       <&pca9555_20 11 GPIO_ACTIVE_HIGH>;
 		reset-assert-us = <20000>;
+		power-on-delay-us = <100000>;
 		reset-post-delay-us = <100000>;
 		status = "okay";
 	};
@@ -167,16 +180,30 @@ &i2c3 {
 	pca9555_20: pca9555@20 {
 		compatible = "nxp,pca9555";
 		reg = <0x20>;
+		gpio-controller;
+		#gpio-cells = <2>;
 		status = "okay";
 	};
 
 	pca9555_21: pca9555@21 {
 		compatible = "nxp,pca9555";
 		reg = <0x21>;
+		gpio-controller;
+		#gpio-cells = <2>;
 		status = "okay";
 	};
 };
 
+&rknpu {
+	rknpu-supply = <&vdd_npu_s0>;
+	mem-supply = <&vdd_npu_mem_s0>;
+	status = "okay";
+};
+
+&rknpu_mmu {
+	status = "okay";
+};
+
 &saradc {
 	status = "okay";
 	vref-supply = <&vcc_1v8_s0>;
@@ -340,6 +367,7 @@ &gmac0 {
 	snps,reset-delays-us = <0 20000 100000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&gmac0_miim
+		     &gmac0_clkinout
 		     &gmac0_tx_bus2
 		     &gmac0_rx_bus2
 		     &gmac0_rgmii_clk
@@ -364,6 +392,7 @@ &gmac1 {
 	snps,reset-delays-us = <0 20000 100000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&gmac1_miim
+		     &gmac1_clkinout
 		     &gmac1_tx_bus2
 		     &gmac1_rx_bus2
 		     &gmac1_rgmii_clk
diff --git a/drivers/usb/misc/agibot-hub-reset.c b/drivers/usb/misc/agibot-hub-reset.c
index 15eb2a6bf37c..bc58b7dd75d9 100644
--- a/drivers/usb/misc/agibot-hub-reset.c
+++ b/drivers/usb/misc/agibot-hub-reset.c
@@ -16,7 +16,9 @@
 
 struct agibot_hub_reset {
 	struct gpio_descs *reset_gpios;
+	struct gpio_descs *enable_gpios;
 	u32 assert_us;
+	u32 power_on_delay_us;
 	u32 post_delay_us;
 };
 
@@ -31,23 +33,35 @@ static int agibot_hub_reset_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	device_property_read_u32(dev, "reset-assert-us", &hub->assert_us);
+	device_property_read_u32(dev, "power-on-delay-us",
+				 &hub->power_on_delay_us);
 	device_property_read_u32(dev, "reset-post-delay-us", &hub->post_delay_us);
 
-	hub->reset_gpios = devm_gpiod_get_array(dev, "reset", GPIOD_OUT_LOW);
+	/* ACTIVE_LOW reset lines: logical high asserts, logical low releases. */
+	hub->reset_gpios = devm_gpiod_get_array(dev, "reset", GPIOD_OUT_HIGH);
 	if (IS_ERR(hub->reset_gpios))
 		return dev_err_probe(dev, PTR_ERR(hub->reset_gpios),
 				     "failed to acquire hub reset GPIOs\n");
 
+	hub->enable_gpios = devm_gpiod_get_array(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(hub->enable_gpios))
+		return dev_err_probe(dev, PTR_ERR(hub->enable_gpios),
+				     "failed to acquire hub power GPIOs\n");
+
+	for (i = 0; i < hub->enable_gpios->ndescs; ++i)
+		gpiod_set_value_cansleep(hub->enable_gpios->desc[i], 1);
+
+	fsleep(hub->power_on_delay_us);
 	fsleep(hub->assert_us);
 
 	for (i = 0; i < hub->reset_gpios->ndescs; ++i)
-		gpiod_set_value_cansleep(hub->reset_gpios->desc[i], 1);
+		gpiod_set_value_cansleep(hub->reset_gpios->desc[i], 0);
 
 	fsleep(hub->post_delay_us);
 	platform_set_drvdata(pdev, hub);
 
-	dev_info(dev, "released %d USB hub reset GPIOs after %u us\n",
-		 hub->reset_gpios->ndescs, hub->assert_us);
+	dev_info(dev, "enabled %d USB power rails and released %d hub resets\n",
+		 hub->enable_gpios->ndescs, hub->reset_gpios->ndescs);
 
 	return 0;
 }
-- 
2.53.0

