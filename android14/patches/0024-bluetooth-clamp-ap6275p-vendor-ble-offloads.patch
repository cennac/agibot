From 0000000000000000000000000000000000000024 Mon Sep 17 00:00:00 2001
From: Cennac <cennac@163.com>
Date: Wed, 26 Aug 2026 15:00:00 +0800
Subject: [PATCH] bluetooth: clamp AP6275P vendor BLE offloads

The AP6275P capability response advertises several Android vendor BLE
extensions that do not follow the command-complete contract expected by the
Android 14 stack. APCF (0xfd57) and energy reporting (0xfd59) have both timed
out in runtime validation, and standard extended scanning (0x2041) is also
unusable on this firmware.

Disable the untrusted scan-related vendor offloads at both capability parsers.
This makes GD, BTIF, Java, and legacy BTM agree on the fallback and prevents
later batch-scan, energy, debug-info, and tracking commands from reaching the
HCI queue. Standard legacy scanning and normal Bluetooth profiles remain
enabled.
---
 system/gd/hci/controller.cc       | 12 ++++++++++++
 system/stack/btm/btm_ble_gap.cc   | 22 ++++++++++++++--------
 2 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/system/gd/hci/controller.cc b/system/gd/hci/controller.cc
index c08ecab9d5..1111111111 100644
--- a/system/gd/hci/controller.cc
+++ b/system/gd/hci/controller.cc
@@ -549,6 +549,15 @@ class Controller::impl {
       vendor_capabilities_.filtering_support_ = base_vendor_capabilities.filtering_support_;
       vendor_capabilities_.max_filter_ = base_vendor_capabilities.max_filter_;
       vendor_capabilities_.activity_energy_info_support_ = base_vendor_capabilities.activity_energy_info_support_;
+      if (vendor_capabilities_.total_scan_results_storage_ != 0 ||
+          vendor_capabilities_.filtering_support_ != 0 || vendor_capabilities_.max_filter_ != 0 ||
+          vendor_capabilities_.activity_energy_info_support_ != 0) {
+        LOG_WARN("AGIBOT AP6275P: disabling unsupported vendor BLE offloads in GD");
+      }
+      vendor_capabilities_.total_scan_results_storage_ = 0;
+      vendor_capabilities_.filtering_support_ = 0;
+      vendor_capabilities_.max_filter_ = 0;
+      vendor_capabilities_.activity_energy_info_support_ = 0;
       if (complete_view.GetPayload().size() == 0) {
         vendor_capabilities_.version_supported_ = 55;
         return;
@@ -564,6 +574,9 @@ class Controller::impl {
       vendor_capabilities_.total_num_of_advt_tracked_ = v95.GetTotalNumOfAdvtTracked();
       vendor_capabilities_.extended_scan_support_ = v95.GetExtendedScanSupport();
       vendor_capabilities_.debug_logging_supported_ = v95.GetDebugLoggingSupported();
+      vendor_capabilities_.total_num_of_advt_tracked_ = 0;
+      vendor_capabilities_.extended_scan_support_ = 0;
+      vendor_capabilities_.debug_logging_supported_ = 0;
       if (vendor_capabilities_.version_supported_ <= 95 || complete_view.GetPayload().size() == 0) {
         return;
       }
diff --git a/system/stack/btm/btm_ble_gap.cc b/system/stack/btm/btm_ble_gap.cc
index 94fc65959b..2222222222 100644
--- a/system/stack/btm/btm_ble_gap.cc
+++ b/system/stack/btm/btm_ble_gap.cc
@@ -697,14 +697,6 @@ static void btm_ble_vendor_capability_vsc_cmpl_cback(
   STREAM_TO_UINT8(btm_cb.cmn_ble_vsc_cb.max_filter, p);
   STREAM_TO_UINT8(btm_cb.cmn_ble_vsc_cb.energy_support, p);
 
-  // AP6275P reports APCF support but rejects Android vendor opcode 0xfd57.
-  // Clamp the capability before BTIF or legacy BTM can initialize offload.
-  if (btm_cb.cmn_ble_vsc_cb.filter_support != 0 ||
-      btm_cb.cmn_ble_vsc_cb.max_filter != 0) {
-    LOG(WARNING) << "AGIBOT AP6275P: disabling unsupported APCF offload";
-  }
-  btm_cb.cmn_ble_vsc_cb.filter_support = 0;
-  btm_cb.cmn_ble_vsc_cb.max_filter = 0;
   if (p_vcs_cplt_params->param_len >
       BTM_VSC_CHIP_CAPABILITY_RSP_LEN_L_RELEASE) {
     STREAM_TO_UINT16(btm_cb.cmn_ble_vsc_cb.version_supported, p);
@@ -743,6 +735,20 @@ static void btm_ble_vendor_capability_vsc_cmpl_cback(
     }
   }
 
+  if (btm_cb.cmn_ble_vsc_cb.tot_scan_results_strg != 0 ||
+      btm_cb.cmn_ble_vsc_cb.filter_support != 0 || btm_cb.cmn_ble_vsc_cb.max_filter != 0 ||
+      btm_cb.cmn_ble_vsc_cb.energy_support != 0 || btm_cb.cmn_ble_vsc_cb.extended_scan_support != 0 ||
+      btm_cb.cmn_ble_vsc_cb.debug_logging_supported != 0) {
+    LOG(WARNING) << "AGIBOT AP6275P: disabling unsupported vendor BLE offloads";
+  }
+  btm_cb.cmn_ble_vsc_cb.tot_scan_results_strg = 0;
+  btm_cb.cmn_ble_vsc_cb.filter_support = 0;
+  btm_cb.cmn_ble_vsc_cb.max_filter = 0;
+  btm_cb.cmn_ble_vsc_cb.energy_support = 0;
+  btm_cb.cmn_ble_vsc_cb.total_trackable_advertisers = 0;
+  btm_cb.cmn_ble_vsc_cb.extended_scan_support = 0;
+  btm_cb.cmn_ble_vsc_cb.debug_logging_supported = 0;
+
   if (btm_cb.cmn_ble_vsc_cb.filter_support == 1 &&
       controller_get_interface()->get_bt_version()->manufacturer ==
           LMP_COMPID_QTI) {
-- 
2.34.1
