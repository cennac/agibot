+static struct clk *rk_gmac_get_legacy_clk(struct rk_priv_data *bsp_priv,
+					   const char *id)
+{
+	struct device *dev = &bsp_priv->pdev->dev;
+	struct clk *clk;
+
+	if (bsp_priv->ops->legacy_clks_optional)
+		clk = devm_clk_get_optional(dev, id);
+	else
+		clk = devm_clk_get(dev, id);
+
+	if (IS_ERR(clk))
+		dev_err(dev, "cannot get clock %s\n", id);
+
+	return clk;
+}
